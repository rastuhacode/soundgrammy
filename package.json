{
  "name": "soundgrammy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "taze": "taze -l",
    "postinstall": "turbo run build --filter=\"./packages/*\""
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "taze": "^19.9.2",
    "turbo": "^2.8.3",
    "typescript": "^5.9.3"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "test": {},
      "lint": {
        "@eslint/js": "^9.39.2",
        "@next/eslint-plugin-next": "^16.1.6",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-only-warn": "^1.1.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-turbo": "^2.8.3",
        "globals": "^17.3.0",
        "prettier": "^3.8.1",
        "typescript-eslint": "^8.54.0"
      },
      "build": {
        "turbo": "^2.8.3",
        "tsdown": "^0.20.3"
      },
      "script": {
        "taze": "^19.9.2"
      },
      "frontend": {
        "next": "16.1.6",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
      },
      "backend": {
        "better-sqlite3": "^12.6.2",
        "jose": "^6.1.3",
        "grammy": "^1.39.3"
      },
      "types": {
        "@types/bun": "^1.3.8",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.2.1",
        "@types/react": "^19.2.13",
        "@types/react-dom": "^19.2.3",
        "typescript": "~5.9.3"
      }
    }
  },
  "engines": {
    "node": ">=22.7.0"
  },
  "packageManager": "bun@1.3.8"
}
