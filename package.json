{
  "name": "soundgrammy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "taze": "taze -l",
    "postinstall": "turbo run build --filter=\"./packages/*\""
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "taze": "^19.9.2",
    "turbo": "^2.8.3",
    "typescript": "^5.9.3"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "test": {},
      "lint": {
        "@eslint/js": "^10.0.1",
        "@next/eslint-plugin-next": "^16.1.6",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-only-warn": "^1.1.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-turbo": "^2.8.3",
        "globals": "^17.3.0",
        "prettier": "^3.8.1",
        "typescript-eslint": "^8.54.0"
      },
      "build": {
        "@tailwindcss/postcss": "^4.1.18",
        "postcss": "^8.5.6",
        "shadcn": "^3.8.4",
        "tailwindcss": "^4.1.18",
        "turbo": "^2.8.3",
        "tsdown": "^0.20.3",
        "tw-animate-css": "^1.4.0"
      },
      "script": {
        "taze": "^19.9.2"
      },
      "frontend": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.563.0",
        "next": "16.1.6",
        "radix-ui": "^1.4.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tailwind-merge": "^3.4.0"
      },
      "backend": {
        "better-sqlite3": "^12.6.2",
        "jose": "^6.1.3",
        "grammy": "^1.39.3"
      },
      "types": {
        "@types/bun": "^1.3.8",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.2.2",
        "@types/react": "^19.2.13",
        "@types/react-dom": "^19.2.3",
        "typescript": "~5.9.3"
      }
    }
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "packageManager": "bun@1.3.14"
}
