{
  "name": "soundgrammy",
  "version": "3.3.0",
  "author": "Rasten Remizov",
  "license": "GPL-3.0-only",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:android:dev": "tauri android dev --config src-tauri/tauri.android.dev.conf.json",
    "tauri:build": "tauri build",
    "generate-icons": "tauri icon src-tauri/icons/original/soundgrammy-original.svg -o src-tauri/icons --ios-color \"#0088CC\" && cp src-tauri/icons/32x32.png public/favicon-32x32.png && cp src-tauri/icons/icon.ico public/favicon.ico && cp src-tauri/icons/ios/AppIcon-60x60@3x.png public/apple-touch-icon.png",
    "check:versions": "bun run scripts/check-version-sync.ts",
    "lint": "bun run lint:frontend && bun run lint:backend",
    "lint:frontend": "eslint .",
    "lint:backend": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "bun run format:frontend && bun run format:backend",
    "format:frontend": "eslint --fix .",
    "format:backend": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:frontend && bun run test:backend",
    "test:frontend": "vitest run",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/hooks": "^9.6.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@types/node": "^26.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "maska": "^3.2.1",
    "motion": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  }
}
