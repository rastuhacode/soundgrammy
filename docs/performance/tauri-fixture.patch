+import type { Track } from '@/types'
+let fixture: any = null
+let tracks:any[]=[]
+let playerCache:any=null, snapshotCache:any=null
+export function setAuditFixture(value: unknown) {fixture=value; tracks=fixture?.tracks.map((t:any)=>({...t,tg_user_id:1,file_id:'',file_unique_id:String(t.id),source:'profile',created_at:'2026-11-14T00:00:00Z'}))??[]}
+export function auditResponse(command:string,args?:Record<string,unknown>): {handled:boolean,value:any} {
+ if(!fixture)return {handled:false,value:null}
+ const status={tgUserId:1,revision:1,indexed:tracks.length,total:tracks.length,complete:true,blocking:false,processed:tracks.length,lastSyncAt:'2026-11-14T00:00:00Z'}
+ const user={id:1,firstName:'SoundGrammy',lastName:null,username:null,phone:null}
+ const player=playerCache??={revision:1,attempt:1,isPlaying:false,endReason:'',preferences:{repeat:'none',shuffle:'off',mode:'random'},queue:{tracks,cursor:4,source:{type:'playlist',playlistId:'all',name:'All tracks',trackIds:tracks.map((t:Track)=>t.id)},sourceIndices:null,baseEntries:null}}
+ const snapshot=snapshotCache??={revision:1,kind:'native-rust',status:'paused',player,trackId:5,attemptId:null,currentTimeSeconds:83,durationSeconds:196,bufferedRanges:[],volumePercent:25,error:null,initialLoading:false,seeking:false}
+ let value:any=null
+ switch(command){
+  case 'auth_status': case 'refresh_auth':value={authorized:true,user};break
+  case 'list_tracks_page':{const offset=Number(args?.offset??0);value={tracks:tracks.slice(offset,offset+500).map((track:Track,i:number)=>({track,position:offset+i})),status,nextOffset:offset+500<tracks.length?offset+500:null};break}
+  case 'list_playlists':value={liked:{id:1,trackIds:[1,3,5],updatedAt:'2026-11-14'},custom:[{id:2,name:'Presentation',trackIds:[1,2,1,4],updatedAt:'2026-11-14'}]};break
+  case 'list_listen_stats':case 'get_cache_status':value=[];break
+  case 'get_listen_statistics_enabled':value=true;break
+  case 'get_lastfm_status':value={configured:false,connected:false,enabled:false,username:null,pendingCount:0};break
+  case 'native_audio_capabilities':value={available:true,streaming:true,codecs:[]};break
+  case 'native_audio_snapshot':case 'native_player_command':value=snapshot;break
+  case 'sync_saved_music':value={changed:false,total:tracks.length,lastSyncAt:status.lastSyncAt};break
+  case 'sync_status':value=status.lastSyncAt;break
+  case 'get_track_thumbnail':case 'get_user_avatar':value=null;break
+  case 'get_profile':value={tgUserId:1,firstName:'SoundGrammy',lastName:null,username:null,phone:null};break
+  default:if(command.startsWith('native_audio_')) return {handled:true,value:snapshot}; return {handled:false,value:null}
+ }
+ return {handled:true,value}
+}
